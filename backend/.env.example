NVIDIA_API_KEY=nvapi-...
API_BASE_URL=https://api.nvidia.com/v1
STORAGE_DIR=./uploads

# gRPC (auto-discovered at startup from NVCF API, or set explicitly)
# GRPC_SERVER=grpc.nvcf.nvidia.com:443
# TTS_FUNCTION_ID=
# ASR_FUNCTION_ID=
# BNR_FUNCTION_ID=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
